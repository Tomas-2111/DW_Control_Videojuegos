            <component
              refId="Package\Poblar H_Servicios\ADO NET Source"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
              description="Consumes data from SQL Server, OLE DB, ODBC, or Oracle, using the corresponding .NET Framework data provider. Use a Transact-SQL statement to define the result set. For example, extract data from SQL Server with the .NET Framework data provider for SQL Server."
              name="ADO NET Source"
              usesDispositions="true"
              version="4">
              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement used by the component to extract data."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    -- 1. Llaves de Tiempo (Formato YYYYMM)
    CONVERT(INT, CONVERT(VARCHAR(6), t.Fecha_Ingreso, 112)) AS Id_Fecha_Ingreso,
    CASE 
        WHEN t.Fecha_Cierre IS NOT NULL THEN CONVERT(INT, CONVERT(VARCHAR(6), t.Fecha_Cierre, 112))
        ELSE NULL 
    END AS Id_Fecha_Cierre,
    
    -- 2. Llaves Subrogadas del DW
    -- Usamos ISNULL para que si no encuentra el cliente por cédula, intente no dejarlo roto (o mapear a un miembro desconocido)
    dc.Id_Cliente AS Id_Cliente,
    de.Id_Equipo AS Id_Equipo,
    dt.Id_Tecnico AS Id_Tecnico,
    dd.Id_Diagnostico AS Id_Diagnostico,
    
    -- 3. Atributos de Degenerados / Estado
    t.ID_Ticket AS Id_Ticket_NK,
    t.Estado_Ticket AS Estado_Ticket,
    
    -- 4. CÁLCULOS Y MÉTRICAS
    CASE 
        WHEN t.Fecha_Cierre IS NOT NULL THEN CAST(DATEDIFF(MINUTE, t.Fecha_Ingreso, t.Fecha_Cierre) / 60.0 AS DECIMAL(8,2))
        ELSE NULL 
    END AS Tiempo_Atencion_Horas,
    
    ISNULL(t.Monto_Total, 0.00) AS Monto_Ingreso,
    
    -- Costo Total de Repuestos
    ISNULL((
        SELECT SUM(tr.Cantidad * tr.Costo_Aplicado)
        FROM BD_Control_Videojuegos.dbo.Ticket_Repuesto tr
        WHERE tr.ID_Ticket = t.ID_Ticket
    ), 0.00) AS Costo_Repuestos_Total,
    
    -- Utilidad Estimada (Corregida y exacta)
    ISNULL(t.Monto_Total, 0.00) - ISNULL((
        SELECT SUM(tr.Cantidad * tr.Costo_Aplicado)
        FROM BD_Control_Videojuegos.dbo.Ticket_Repuesto tr
        WHERE tr.ID_Ticket = t.ID_Ticket
    ), 0.00) AS Utilidad_Estimada

FROM BD_Control_Videojuegos.dbo.Ticket t
-- ¡REVISAR ESTE JOIN! Asegúrate de que dc.Cedula_Pasaporte contenga los valores '111111111', '222222222', etc.
LEFT JOIN DW_Videojuegos.dbo.D_Cliente dc 
    ON t.ID_Cliente = dc.Cedula_Pasaporte
LEFT JOIN DW_Videojuegos.dbo.D_Equipo de 
    ON t.ID_Equipo = de.Id_Equipo_NK
LEFT JOIN DW_Videojuegos.dbo.D_Tecnico dt 
    ON t.ID_Tecnico = dt.Cedula_Tecnico
LEFT JOIN BD_Control_Videojuegos.dbo.Diagnostico diag_trans 
    ON t.ID_Ticket = diag_trans.ID_Ticket
LEFT JOIN DW_Videojuegos.dbo.D_Diagnostico dd 
    ON diag_trans.ID_Diagnostico = dd.Id_Diagnostico_NK;</property>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">30</property>
